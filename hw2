# 1A)  Load the bird migrations data set and fit a linear regression to test the 
# hypothesis described in the readme.  *Warming spring temperatures are correlated 
# with shifts in migration date in bird populations, toward earlier departure
# dates (negative change in migration date).*  
bm<-read.csv("birdmigrations.csv", header=T)

#check if migration date is normally distributed
#look via histogram
hist(bm$migrationchange)

#check via shapiro test
shapiro.test(bm$migrationchange)

#p value is higher than 0.05 so normal because fail to reject null
#linear model
bm_mod<-lm(migrationchange~tempchange, data = bm)

#check assumptions again
plot(bm_mod)
#the first plot shows the raw residuals by IV. 
#no funnel - good
#the second plot shows a qq plot of the residuals - all fall on line
#the third plot is the Scale-Location plot checks for homoscedasticity and all about same
#The 4th plot find high leverage points, line is flat and no points pull
summary(bm_mod)
# Hypothesis that: *Warming spring temperatures are correlated 
# with shifts in migration date in bird populations, toward earlier departure
# dates (negative change in migration date).*
# Linear model statistically supports this hypothesis because the slope of the change in migration
# date is negative and the p value associated with it is <0.05. However, the fit
# of the linear model to the data seems poor (R^2 of 0.01561).
coef(bm_mod)
confint(bm_mod)
rmse(bm_mod, data = bm)

